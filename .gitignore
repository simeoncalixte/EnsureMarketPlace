**/node_modules
**/dist
**/.vscode
!/.vscode/
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
**/channels

# Large geographic source datasets (loaded via `npm run import:worldcities`, not committed)
worldcities.csv
**/worldcities.csv
simplemaps_worldcities_*

# Tesseract OCR trained-data models (downloadable binaries, ~5MB+, not committed)
**/*.traineddata

# Environment files — secrets, never commit. Templates (.env.example) are kept.
**/.env
**/.env.*
!**/.env.example

# Runtime-uploaded files (registration documents, submission uploads) — user data /
# PII, never commit. The app recreates these dirs at runtime.
**/storage/registration-documents/
**/storage/uploads/

# Local metadata and environment copies
.DS_Store
**/.env*
!**/.env.example

# Local database migration backups
/docker-backups/

# Local rollout database snapshots and image references
/output/platform-admin-rollout/

# Local Network demo credentials and seed manifests
/output/network-seed/

# Local Python execution caches
**/__pycache__/
**/*.pyc

# Jira exports containing personal account email addresses; never commit (public repository)
/output/filter-button-delivery-2026-11-09/jira-baseline.json
/output/filter-button-delivery-2026-11-09/jira-final.json
/output/filter-button-review-2026-11-09/jira-final.json
/output/publish-versioned-2026-11-14/jira-final.json
