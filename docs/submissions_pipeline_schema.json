{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Submissions Pipeline Schema",
  "description": "Schema representing the data pipeline for submissions, capturing raw source metadata, column definitions and transformation history.",
  "type": "object",
  "required": ["submissionId", "sourceTitle", "columns", "pipeline"],
  "properties": {
    "submissionId": { "type": "string", "description": "Unique identifier for this submission." },
    "receivedAt": { "type": "string", "format": "date-time", "description": "When the submission was received." },
    "sourceTitle": { "type": "string", "description": "Human-readable title for the raw data source." },
    "sourceType": { "type": "string", "enum": ["csv", "json", "api", "database", "parquet", "other"], "description": "Type of raw source." },
    "sourceLocation": { "type": "string", "description": "URI or path pointing to raw source data (optional for inline payloads)." },
    "rawData": { "type": "array", "description": "Optional small sample of raw rows", "items": { "type": "object" } },
    "columns": {
      "type": "array",
      "description": "Column-level metadata and transformation history",
      "items": {
        "type": "object",
        "required": ["name", "dataType", "transformations"],
        "properties": {
          "name": { "type": "string", "description": "Canonical column name used in downstream models." },
          "originalName": { "type": "string", "description": "Original name from the raw source." },
          "dataType": { "type": "string", "description": "Type after transformation (e.g., string, integer, date)." },
          "isKey": { "type": "boolean", "description": "Whether this column is a key/identifier." },
          "isSensitive": { "type": "boolean", "description": "Whether this column contains sensitive data." },
          "rawSampleValues": { "type": "array", "items": {}, "description": "Example raw values from the source." },
          "transformations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "appliedBy", "appliedAt"],
              "properties": {
                "name": { "type": "string", "description": "Name of the transformation step." },
                "type": { "type": "string", "enum": ["cast", "map", "cleanse", "derive", "aggregate", "validate", "enrich", "split", "join", "filter", "other"], "description": "Transformation category." },
                "description": { "type": "string", "description": "Short human-readable description." },
                "parameters": { "type": "object", "description": "Parameters used by the transformation." },
                "appliedBy": { "type": "string", "description": "Service/script that applied the transformation." },
                "appliedAt": { "type": "string", "format": "date-time", "description": "Timestamp when applied." },
                "outputName": { "type": "string", "description": "Output column name (if renamed)." },
                "outputType": { "type": "string", "description": "Output data type." }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "pipeline": {
      "type": "array",
      "description": "Ordered list of processes applied to submission",
      "items": {
        "type": "object",
        "required": ["step", "status"],
        "properties": {
          "step": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "running", "completed", "failed"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time" },
          "details": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "schemaVersion": { "type": "string" },
    "pipelineVersion": { "type": "string" }
  },
  "additionalProperties": false
}
