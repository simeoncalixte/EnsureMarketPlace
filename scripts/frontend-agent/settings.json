{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm --prefix EnsuredUI run *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(PLAYWRIGHT_MODULE=* node *)"
    ],
    "deny": ["Read(./**/.env)", "Read(./**/.env.*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/frontend-agent/guard.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/frontend-agent/gate.mjs\" --hook",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
