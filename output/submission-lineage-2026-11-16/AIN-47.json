          "fields": {
            "summary": "[Gap][Finance] Define currency and minor-unit rules across all financial models",
            "status": {
              "self": "https://simeoncalixte1990.atlassian.net/rest/api/3/status/3",
              "description": "This work item is being actively worked on at the moment by the assignee.",
