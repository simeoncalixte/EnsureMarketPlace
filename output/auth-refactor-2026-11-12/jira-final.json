  "regression": {
    "expand": "renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations",
    "id": "10498",
    "self": "https://simeoncalixte1990.atlassian.net/rest/api/3/issue/10498",
    "key": "AIN-175",
    "fields": {
      "summary": "[Auth tests] Account for consolidated editor aliases in administrator navigation assertion",
      "description": {
        "type": "doc",
        "version": 1,
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Baseline gateway.test.ts failed before the auth refactor: it compared the consolidated administrator menu to every raw catalog entry, including editor aliases intentionally removed by consolidateInsurerWorkspace. Verified EnsuredUI/src/AppRoutes.tsx maps those risk/coverage aliases to the same InsurerDashboard component. Acceptance: compare effective persona destinations using explicit verified alias mappings, assert aliases stay consolidated, preserve navigation behavior, and pass the gateway suite. No product/UI changes; screenshots and Storybook not applicable. This is a test defect discovered while executing AIN-174."
              }
            ]
          }
        ]
      },
