[
  {
    "expand": "renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations",
    "id": "10230",
    "self": "https://simeoncalixte1990.atlassian.net/rest/api/3/issue/10230",
    "key": "AIN-1",
    "fields": {
      "summary": "[Ensured] Establish a reproducible, operable platform release",
      "description": {
        "type": "doc",
        "version": 1,
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Completion review: 2026-11-01. Scope: current local EnsureMarketPlace checkout plus existing Jira inventory. This is a code/document review, not a production audit. Existing implementations are to be extended. No full test suite was run."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Delivery: Insurer pilot | Planning priority: P0 (P0 = pilot blocker; P1 = next delivery priority)."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Observed state and evidence"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "API typecheck passed on 2026-11-01. npm run pipeline:verify reports runtime differences and fails because EnsuredPipelineSchemaGeneration/src/pipeline/schemaGeneration/catalogAssembly.ts is missing. Many submodule working trees are modified. Root test:all refers to a channels directory absent from this checkout. Package workflows exist; this is not a request to recreate them."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Scope"
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Reconcile parity manifests with current package ownership; repair required build/test entry points and document supported Node version."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Capture reviewed submodule commits and compatible package versions in a clean reproducible release."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Complete staging deployment, service secrets/configuration, health checks, structured telemetry, backup/restore and rollback runbooks."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Acceptance criteria"
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "A clean recursive checkout installs, builds and passes pipeline parity/component-policy checks in CI."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Required checks run against isolated databases and include every release service; no reliance on uncommitted local files."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Staging deploy and rollback are rehearsed; database restore is verified; operators can diagnose failed jobs and provider outages."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Dependencies"
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Can start immediately; coordinate shared contracts with other completion epics."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Implementation constraints"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Preserve working functionality, tenant isolation, additive migrations and append-only audit/replay. Keep engines driven by risk-class configuration. Do not present seeded/illustrative figures as verified financial results. Owners and estimates remain unassigned until delivery planning."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Persona outcome delivery map \u2014 2026-11-04"
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Required child outcomes"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "AIN-119: Synchronize policy claims and accounting records with recoverable handoffs"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "AIN-93: Recover interrupted workflows and restore consistent business history"
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Definition of Done clarification"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Preserve every original acceptance criterion and existing child obligation. Close only after all required children, subtasks and predecessor outcomes are implemented and verified; adding these stories does not replace prior scope."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "All acceptance criteria and the story-specific verification scenario pass; link implementation tasks/PRs and record the reviewed source/package versions. A partial component or newly created ticket does not satisfy this story."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Every changed UI workflow has executable Storybook play functions asserting user actions, observable results and exact submitted payloads, including success, validation, failure/retry, empty/loading, pagination and permission/revocation states where applicable. Document a reason for any nonapplicable state. Include keyboard and narrow-screen checks."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Fixture stories use isolated synthetic transports with accidental application writes blocked. Also run authenticated real-service journeys against isolated Docker databases/services for authorization, durable state, concurrency, idempotency and relevant money invariants. Backend-only work uses integration evidence linked to this story, not artificial UI."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Attach ticket \u2192 component \u2192 Storybook story IDs \u2192 command/results mapping, regression evidence, API/database checks and known coverage gaps to Jira and TASK_HANDOFF.md. New failures have linked bug tickets and regressions; no unresolved failure of an acceptance criterion permits Done."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Reconcile all required dependencies and subtasks. Record migration/backfill compatibility and rollback results when schemas change. Demonstrate the workflow in the integrated staging environment, identifying deployed build and service versions; local checks alone are not staging evidence. Production deployment remains a separate release gate under AIN-1/12."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "For external-system or monetary settlement claims, attach configured vendor/provider-sandbox evidence and matched reconciliation; simulated events or manually recorded receipts cannot establish external delivery or settled cash."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "LLM forms architecture"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Generated-form gate: preserve document-driven extensibility, evidence anchors, stable semantic/entity IDs, missing/conflicting states and human corrections; pin schema/catalog/generator versions, reject unsafe generated structures and prove regeneration/replay behavior. LLM output never independently grants authority, approves coverage, sets eligibility or posts money."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Current evidence"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Stories created for planning; no new implementation/test/migration/deployment result. Existing completed work is reusable evidence only."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Single-developer sprint sequence \u2014 2026-11-04"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Roadmap priority 1 of 14 open epics. One developer, two-week sprints"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "S01 Build and paid-access guardrails: AIN-13"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "S52 Pilot system adapter contracts: AIN-136"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "S53 External system reconciliation: AIN-119"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "S55 Restore and operational recovery: AIN-14, AIN-93"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Historical epic-level Blocks links remain intact as delivery/release constraints. Readiness for a child uses the named prerequisite milestone, not completion of every late child of a foundational epic. AIN-1 provides build/staging foundations early and full integration/restore late; AIN-47 contracts are early and legacy cutover late. No epic is closed at an early milestone."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Existing active sprint remains active with original dates; only its goal/name and unfinished membership are reorganized. Every new sprint is future and undated. No fabricated story-point/time estimates or assignees. The ordered slots are a provisional work breakdown, not a fixed delivery forecast. Before activation, split any candidate exceeding six implementation days and verify reviewer/provider readiness; preserve all parent acceptance criteria."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Epic completion requires every original criterion, unfinished child/subtask and required dependency, including criteria not exhausted by the sprint issue titles. Early foundation milestones do not close this epic. Full backlog mapping and gate register are recorded on AIN-12 and in TASK_HANDOFF.md."
              }
            ]
          }
        ]
      },
