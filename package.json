{
  "private": true,
  "scripts": {
    "start": "npm --prefix EnsuredUI run start",
    "submission:dev": "npm --prefix SubmissionUI run dev",
    "submission:build": "npm --prefix SubmissionUI run build",
    "submission:preview": "npm --prefix SubmissionUI run preview",
    "start:api": "npm --prefix EnsuredAPI run dev",
    "test": "npm --prefix EnsuredAPI test",
    "test:api": "npm --prefix EnsuredAPI test",
    "test:channels": "npm --prefix channels test",
    "test:all": "npm run test:api && npm run test:channels",
    "start:auth": "npm --prefix EnsuredAuth run dev",
    "start:gateway": "npm --prefix EnsuredAuth run gateway",
    "test:auth": "npm --prefix EnsuredAuth test && npm --prefix EnsuredAPI run test:auth",
    "start:kyc": "npm --prefix EnsuredKYC run dev",
    "test:kyc": "npm --prefix EnsuredKYC test",
    "setup:ui": "npm --prefix EnsuredXDS ci && npm --prefix EnsuredUI ci",
    "build:ui": "npm --prefix EnsuredXDS run build && npm --prefix EnsuredUI run build",
    "storybook:xds": "npm --prefix EnsuredXDS run storybook",
    "test:xds": "npm --prefix EnsuredXDS test"
