{
  "version": "1.1",
  "targeting": { "scope": "global" },
  "sections": [
    {
      "id": "exposure",
      "title": "Exposure",
      "defaultOpen": true,
      "fields": [
        {
          "id": "lob",
          "type": "multiselect",
          "label": "Line of business",
          "optionsSource": "primaryTypes",
          "optionsUrl": "/api/marketplace/filters/options/lob",
          "resolver": {
            "source": "canonicalSubmission",
            "path": "filterIndex.subjects.lineOfBusinessCode",
            "scope": "subject",
            "operator": "in",
            "combineWithSameScope": "sameSubject"
          },
          "uiProps": {
            "placeholder": "Any line of business",
            "searchPlaceholder": "Search line of business..."
          }
        },
        {
          "id": "sub",
          "type": "multiselect",
          "label": "Sub-types",
          "optionsSource": "subTypes",
          "optionsUrl": "/api/marketplace/filters/options/sub?lob={lob}",
          "dependsOn": ["lob"],
          "resolver": {
            "source": "canonicalSubmission",
            "path": "filterIndex.subjects.lineOfBusinessSubTypeCode",
            "scope": "subject",
            "operator": "in",
            "combineWithSameScope": "sameSubject"
          },
          "uiProps": {
            "placeholder": "Any sub type",
            "searchPlaceholder": "Search sub types..."
          }
        },
        {
          "id": "peril",
          "type": "multiselect",
          "label": "Peril",
          "optionsSource": "subjectPerils",
          "optionsUrl": "/api/marketplace/filters/options/peril",
          "resolver": {
            "source": "canonicalSubmission",
            "path": "filterIndex.subjects.perilCodes",
            "scope": "subject",
            "operator": "in",
            "combineWithSameScope": "sameSubject"
          },
          "uiProps": {
            "placeholder": "Any peril",
            "searchPlaceholder": "Search perils..."
          }
        },
        {
          "id": "geography",
          "type": "autocomplete_multi",
          "label": "Geography",
          "resolver": {
            "source": "canonicalSubmission",
            "path": "filterIndex.subjects.geographyEntries",
            "scope": "subject",
            "operator": "contains",
            "combineWithSameScope": "sameSubject"
          },
          "uiProps": {
            "placeholder": "Type a place and press Enter"
          }
        },
        {
          "id": "tiv",
          "type": "minmax",
          "label": "TIV ($ range)",
          "resolver": {
            "source": "canonicalSubmission",
            "path": "filterIndex.subjects.tiv",
            "scope": "subject",
            "operator": "range",
            "combineWithSameScope": "sameSubject"
          }
        },
        { "id": "capacity", "type": "minmax", "label": "Capacity" },
        {
          "id": "limit",
          "type": "minmax",
          "label": "Limit",
          "resolver": {
            "source": "canonicalSubmission",
            "path": "filterIndex.subjects.limit",
            "scope": "subject",
            "operator": "range",
            "combineWithSameScope": "sameSubject"
          }
        },
        {
          "id": "attachment",
          "type": "minmax",
          "label": "Attachment",
          "resolver": {
            "source": "canonicalSubmission",
            "path": "filterIndex.subjects.attachment",
            "scope": "subject",
            "operator": "range",
            "combineWithSameScope": "sameSubject"
          }
        }
      ]
    },
    {
      "id": "financial",
      "title": "Financial",
      "fields": [
        { "id": "premium", "type": "disabled_minmax", "label": "Premium ($ range)" },
        { "id": "yield", "type": "minmax", "label": "Yield (%)" },
        { "id": "expectedRoi", "type": "disabled_minmax", "label": "Expected ROI (%)" },
        { "id": "brokerage", "type": "disabled_minmax", "label": "Brokerage (%)" },
        { "id": "lossRatio", "type": "disabled_minmax", "label": "Loss ratio (%)" }
      ]
    },
    {
      "id": "risk",
      "title": "Risk",
      "fields": [
        {
          "id": "catPeril",
          "type": "multiselect",
          "label": "CAT peril",
          "optionsSource": "catPerils",
          "optionsUrl": "/api/marketplace/filters/options/catPeril",
          "resolver": {
            "source": "catScore",
            "path": "peril",
            "scope": "catScore",
            "operator": "in"
          },
          "uiProps": {
            "placeholder": "Any CAT peril",
            "searchPlaceholder": "Search CAT perils..."
          }
        },
        {
          "id": "catScore",
          "type": "minmax",
          "label": "CAT score",
          "resolver": {
            "source": "catScore",
            "path": "scoreValue",
            "scope": "catScore",
            "operator": "range"
          }
        },
        {
          "id": "catBand",
          "type": "multiselect",
          "label": "CAT band",
          "optionsSource": "catBands",
          "optionsUrl": "/api/marketplace/filters/options/catBand",
          "resolver": {
            "source": "catScore",
            "path": "riskBand",
            "scope": "catScore",
            "operator": "in"
          },
          "uiProps": {
            "placeholder": "Any CAT band",
            "searchPlaceholder": "Search CAT bands..."
          }
        },
        {
          "id": "catModelVersion",
          "type": "multiselect",
          "label": "CAT model version",
          "optionsSource": "catModelVersions",
          "optionsUrl": "/api/marketplace/filters/options/catModelVersion",
          "resolver": {
            "source": "catScore",
            "path": "modelVersion",
            "scope": "catScore",
            "operator": "in"
          },
          "uiProps": {
            "placeholder": "Any model version",
            "searchPlaceholder": "Search model versions..."
          }
        },
        {
          "id": "catRecommendedAction",
          "type": "multiselect",
          "label": "CAT underwriting action",
          "optionsSource": "catRecommendedActions",
          "optionsUrl": "/api/marketplace/filters/options/catRecommendedAction",
          "resolver": {
            "source": "catScore",
            "path": "recommendedAction",
            "scope": "catScore",
            "operator": "in"
          },
          "uiProps": {
            "placeholder": "Any action",
            "searchPlaceholder": "Search actions..."
          }
        }
      ]
    },
    {
      "id": "market",
      "title": "Market",
      "fields": [
        {
          "id": "broker",
          "type": "multiselect",
          "label": "Broker",
          "optionsSource": "brokers",
          "optionsUrl": "/api/marketplace/filters/options/broker",
          "resolver": {
            "source": "canonicalSubmission",
            "path": "filterIndex.brokerOrganizationId",
            "scope": "submission",
            "operator": "in"
          },
          "uiProps": {
            "placeholder": "Any broker",
            "searchPlaceholder": "Search brokers..."
          }
        },
        {
          "id": "carrier",
          "type": "multiselect",
          "label": "Carrier",
          "optionsSource": "carriers",
          "optionsUrl": "/api/marketplace/filters/options/carrier",
          "resolver": {
            "source": "canonicalSubmission",
            "path": "filterIndex.carrierOrganizationId",
            "scope": "submission",
            "operator": "in"
          },
          "uiProps": {
            "placeholder": "Any carrier",
            "searchPlaceholder": "Search carriers..."
          }
        },
        {
          "id": "submissionStatus",
          "type": "multiselect",
          "label": "Submission status",
          "optionsSource": "submissionStatuses",
          "optionsUrl": "/api/marketplace/filters/options/submissionStatus",
          "resolver": {
            "source": "canonicalSubmission",
            "path": "filterIndex.status",
            "scope": "submission",
            "operator": "in"
          },
          "uiProps": {
            "placeholder": "Any status",
            "searchPlaceholder": "Search statuses..."
          }
        },
        {
          "id": "submissionType",
          "type": "custom",
          "slotKey": "submissionTypeTree",
          "resolver": {
            "source": "canonicalSubmission",
            "path": "filterIndex.submissionTypeCode",
            "scope": "submission",
            "operator": "in"
          }
        },
        { "id": "marketAppetite", "type": "disabled_select", "label": "Market appetite" }
      ]
    },
    {
      "id": "time",
      "title": "Time",
      "fields": [
        {
          "id": "maxDurationMonths",
          "type": "range",
          "label": "Max term",
          "uiProps": {
            "min": 3,
            "max": 36,
            "step": 1,
            "defaultValue": 36,
            "showAnyAtMax": true,
            "labels": ["3M", "12M", "24M", "36M"]
          }
        }
      ]
    }
  ]
}
