{
  "name": "ensured-api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify + Sequelize + TypeScript API template for Ensured Marketplace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "TS_NODE_TRANSPILE_ONLY=true node --watch -r ts-node/register src/server.ts",
    "debug": "TS_NODE_TRANSPILE_ONLY=true node --watch --inspect-brk -r ts-node/register src/server.ts",
    "prebuild": "npm run graph:all",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "jest --runInBand --watchman=false",
    "test:watch": "jest --watch --watchman=false",
    "migrate": "ts-node --transpile-only src/db/run-migrations.ts",
    "import:worldcities": "ts-node --transpile-only src/db/import-worldcities.ts",
    "import:cresta-zones": "ts-node --transpile-only src/db/import-cresta-zones.ts",
    "import:benchmark-priors": "ts-node --transpile-only src/db/import-benchmark-priors.ts",
    "seed:benchmark-priors": "ts-node --transpile-only src/db/seed-benchmark-priors.ts",
    "sync:pipeline-operations": "ts-node --transpile-only src/db/sync-pipeline-operations.ts",
    "corpus:generate": "ts-node --transpile-only test/helpers/generateOcrCorpus.ts",
    "graph:calls": "ts-node --transpile-only tools/call-graph/index.ts",
    "graph:erd": "ts-node --transpile-only tools/erd/index.ts",
    "graph:all": "npm run graph:calls && npm run graph:erd",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v"
  },
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^10.0.1",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.31",
    "ajv": "^8.18.0",
    "amqplib": "^0.10.3",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^2.16.105",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "stripe": "^16.12.0",
    "tesseract.js": "^7.0.0",
    "umzug": "^3.8.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "docx": "^9.7.1",
    "jest": "^29.7.0",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
