NODE_ENV=development
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ensured_marketplace
DB_USER=postgres
DB_PASSWORD=postgres
# Google Gemini (AI Studio). When GEMINI_API_KEY is set, the judgment stages use
# a Gemini model as their PRIMARY implementation (the deterministic heuristic in
# each stays as the fallback if the key is absent or a call fails):
#   - classification → Gemini line-of-business agent (else keyword taxonomy)
#   - extraction     → Gemini entity agent           (else regex NER)
#   - validation     → Gemini semantic judge         (else rule-based appetite/scrub)
#   - workflow       → Gemini triage decision        (else rule chain)
# Absent key => every stage runs its free heuristic and NO billable call is made.
# (The quantitative stages — pre-rating, capacity, oracle-attestation — stay
# deterministic and never call a model.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000

# OCR image handling only (text-layer PDF/DOCX/plain text always extract locally).
# OFF by default → scanned/photo images are OCR'd with local Tesseract (free).
# When truthy (and GEMINI_API_KEY set), images go to the Gemini vision model
# instead (paid), with Tesseract as the fallback.
OCR_HIGH_PRECISION=
# OCR_TESSERACT_LANG=eng
# OCR_API_URL=        # cloud Document-AI endpoint; when set, it handles all formats incl. images
# OCR_API_KEY=

# Location Discovery (geocoding of insured-subject addresses). Same free/premium
# pattern as OCR: the open-source OpenStreetMap Nominatim engine is the always-on
# default (no key); set GOOGLE_MAPS_API_KEY to switch to the premium Google
# Geocoding API (rooftop-accurate, paid). Both return the identical normalized
# location shape, so the pipeline stage is agnostic to which one answered.
# GOOGLE_MAPS_API_KEY=                 # when set, the premium Google geocoder takes priority
# GOOGLE_GEOCODE_URL=                  # override the Google Geocoding endpoint (optional)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org   # point at a self-hosted instance for volume
# NOMINATIM_USER_AGENT=EnsuredMarketplace/1.0 (location-discovery)   # required by Nominatim usage policy

# Unified geolocation service (/api/geolocation/*). Wraps every engine behind one
# interface and tries our own DB (Address book + geography hierarchy + geo_shapes
# cache) BEFORE any third party. Reuses the keys above; these add capabilities:
# GOOGLE_ADDRESS_VALIDATION_URL=       # override Google Address Validation endpoint (powers /verify)
# MAPBOX_ACCESS_TOKEN=                 # server-side Mapbox token (Geocoding v6); distinct from the UI's VITE_MAPBOX_TOKEN
# MAPBOX_GEOCODE_URL=https://api.mapbox.com/search/geocode/v6   # override the Mapbox Geocoding base (optional)

# Stripe subscription billing (registration paywall). When STRIPE_SECRET_KEY is
# set, the subscription checkout uses the REAL Stripe API to create a customer +
# subscription. Absent key => a deterministic SIMULATED charge runs instead, so
# the registration → payment flow works end-to-end locally and in CI with no
# billable call (same cost-guard pattern as the Gemini stages above).
STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=pk_test_...   # mirror of VITE_STRIPE_PUBLISHABLE_KEY (UI)
# STRIPE_WEBHOOK_SECRET=whsec_...      # for the subscription lifecycle webhook